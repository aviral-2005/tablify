// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(cuid())
  name          String
  email         String          @unique
  passwordHash  String
  role          UserRole        @default(ADMIN)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  restaurants   RestaurantUser[]
}

model Restaurant {
  id              String          @id @default(cuid())
  name            String
  slug            String          @unique
  logoUrl         String?
  coverImageUrl   String?
  description     String?
  phone           String?
  address         String?
  openingHours    String?
  currency        String          @default("INR")
  currencySymbol  String          @default("₹")
  themeColor      String          @default("#D97706")
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  users           RestaurantUser[]
  categories      Category[]
  menuItems       MenuItem[]
  tables          Table[]
  orders          Order[]
}

model RestaurantUser {
  id           String     @id @default(cuid())
  restaurantId String
  userId       String
  role         StaffRole  @default(ADMIN)
  createdAt    DateTime   @default(now())
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, userId])
}

model Category {
  id           String     @id @default(cuid())
  restaurantId String
  name         String
  displayOrder Int        @default(0)
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems    MenuItem[]

  @@index([restaurantId])
}

model MenuItem {
  id            String     @id @default(cuid())
  restaurantId  String
  categoryId    String
  name          String
  description   String?
  price         Decimal    @db.Decimal(10, 2)
  imageUrl      String?
  isVegetarian  Boolean    @default(true)
  isAvailable   Boolean    @default(true)
  displayOrder  Int        @default(0)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category      Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  orderItems    OrderItem[]

  @@index([restaurantId])
  @@index([categoryId])
}

model Table {
  id           String     @id @default(cuid())
  restaurantId String
  tableNumber  String
  displayName  String?
  isActive     Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@unique([restaurantId, tableNumber])
  @@index([restaurantId])
}

model Order {
  id             String      @id @default(cuid())
  restaurantId   String
  tableId        String
  orderNumber    Int
  status         OrderStatus @default(NEW)
  paymentStatus  PaymentStatus @default(UNPAID)
  paymentMethod  String      @default("PAY_AT_COUNTER")
  subtotal       Decimal     @db.Decimal(10, 2)
  customerNote   String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  restaurant     Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table          Table       @relation(fields: [tableId], references: [id], onDelete: Restrict)
  items          OrderItem[]

  @@index([restaurantId])
  @@index([tableId])
  @@index([status])
}

model OrderItem {
  id                String   @id @default(cuid())
  orderId           String
  menuItemId        String
  itemNameSnapshot  String
  priceSnapshot     Decimal  @db.Decimal(10, 2)
  quantity          Int
  note              String?
  createdAt         DateTime @default(now())
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem          MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@index([orderId])
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
}

enum StaffRole {
  ADMIN
  KITCHEN
  WAITER
}

enum OrderStatus {
  NEW
  ACCEPTED
  PREPARING
  READY
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}
